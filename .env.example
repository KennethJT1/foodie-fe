# Copy to .env. Mode-specific overrides (see docs/frontend-switch-to-real-api.md):
#   .env.development.local  real backend for `npm run dev` (git-ignored)
#   .env.mock               MSW mock API for `npm run dev:mock` (committed)

# Base URL of the KJT Foodie API. Locally `/api/v1` goes through the Vite proxy to
# http://localhost:4000. Deployed: https://<api host>/api/v1
VITE_API_URL=/api/v1
# Socket.IO connects straight here (not through the proxy). Deployed: https://<api host>
VITE_SOCKET_URL=http://localhost:4000
# true = run the app on the MSW mock API (no backend needed)
VITE_USE_MOCKS=true
# Must match the backend: both empty (simulated sheet) or both test keys (real Paystack popup)
VITE_PAYSTACK_PUBLIC_KEY=
VITE_GOOGLE_MAPS_KEY=
